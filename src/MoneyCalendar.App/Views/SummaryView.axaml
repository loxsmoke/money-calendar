<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoneyCalendar.App.ViewModels"
             xmlns:controls="using:MoneyCalendar.App.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="MoneyCalendar.App.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">

    <Panel>

        <!-- Loading: skeleton tiles, first load only -->
        <StackPanel IsVisible="{Binding IsLoading}" Spacing="16">
            <Border Classes="card skeleton" Height="56"/>
            <UniformGrid Columns="3">
                <Border Classes="card skeleton" Height="86" Margin="0,0,16,0"/>
                <Border Classes="card skeleton" Height="86" Margin="0,0,16,0"/>
                <Border Classes="card skeleton" Height="86"/>
            </UniformGrid>
            <Border Classes="card skeleton" Height="280"/>
        </StackPanel>

        <!-- Error (first load failed) -->
        <StackPanel IsVisible="{Binding IsError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" HorizontalAlignment="Center"/>
            <Button Content="Retry" Command="{Binding ReloadCommand}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Content: an empty range still shows the chart frame and an empty list -->
        <!-- Padding keeps a gutter for the floating scrollbar so it never sits on a card edge. -->
        <ScrollViewer IsVisible="{Binding !IsLoading}" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,16,0">
            <StackPanel Spacing="16" IsVisible="{Binding !IsError}">

                <!-- Stale-refresh banner -->
                <Border Classes="card" Padding="12,8" IsVisible="{Binding ShowErrorBanner}"
                        Background="{DynamicResource BannerErrorBackgroundBrush}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <!-- Range bar -->
                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <TextBlock Text="Range from" Classes="subtle" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding BackRangeOptions}"
                                      SelectedItem="{Binding SelectedBackRange}"
                                      MinWidth="140" VerticalAlignment="Center"/>
                            <controls:DateField SelectedDate="{Binding StartDate}" VerticalAlignment="Center"/>
                            <TextBlock Text="to" Classes="subtle" VerticalAlignment="Center" Margin="4,0"/>
                            <ComboBox ItemsSource="{Binding ForwardRangeOptions}"
                                      SelectedItem="{Binding SelectedForwardRange}"
                                      MinWidth="140" VerticalAlignment="Center"/>
                            <controls:DateField SelectedDate="{Binding EndDate}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding RangeLabel}" Classes="subtle small" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RangeNotice}" Classes="warning small" VerticalAlignment="Center"
                                       IsVisible="{Binding RangeNotice, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stat tiles -->
                <UniformGrid Columns="3">
                    <Border Classes="card" Margin="0,0,16,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Income" Classes="subtle small"/>
                            <TextBlock Text="{Binding IncomeTotalText}" Classes="stat income"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="0,0,16,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Expenses" Classes="subtle small"/>
                            <TextBlock Text="{Binding ExpenseTotalText}" Classes="stat expense"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Net" Classes="subtle small"/>
                            <TextBlock Text="{Binding NetTotalText}" Classes="stat"
                                       Classes.error="{Binding NetIsNegative}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Chart -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#1B7F3B"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="Income" Classes="subtle small" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#C2603A"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="Expenses" Classes="subtle small" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="16" Height="3" CornerRadius="1.5" Background="#2E9E52"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BalanceLineText}" Classes="subtle small"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="h2" Text="Income and expenses" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SkeletonBrush}" CornerRadius="4" Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BucketLabel}" Classes="small"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart Series="{Binding ChartSeries}"
                                            XAxes="{Binding ChartXAxes}"
                                            YAxes="{Binding ChartYAxes}"
                                            Height="280"/>
                    </StackPanel>
                </Border>

                <!-- Transactions for the range (or the selected day) -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="Add income" Command="{Binding OpenIncomeCommand}"/>
                                <Button Content="Add expense" Command="{Binding OpenExpensesCommand}"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Transactions in range" Classes="h2"/>
                                <TextBlock Text="{Binding ListSubtitleText}" Classes="subtle small"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Nothing here yet — add an entry from the Income or Expenses section."
                                   Classes="subtle" IsVisible="{Binding ListIsEmpty}" Margin="0,12"/>

                        <DataGrid ItemsSource="{Binding Entries}" IsVisible="{Binding !ListIsEmpty}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  MaxHeight="360" Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="150"
                                                    SortMemberPath="Date"/>
                                <DataGridTemplateColumn Header="Category" Width="200" SortMemberPath="CategoryName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:EntryRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0">
                                                <Ellipse Width="9" Height="9" Fill="{Binding CategoryColor}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountText}" Width="180"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding NoteText}" Width="*"/>
                                <DataGridTemplateColumn Header="Amount" Width="130" SortMemberPath="SortAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:EntryRowViewModel">
                                            <TextBlock Text="{Binding AmountText}" TextAlignment="Right"
                                                       Classes.income="{Binding IsIncome}"
                                                       Classes.expense="{Binding !IsIncome}"
                                                       VerticalAlignment="Center" Margin="4,0,10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
