<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoneyCalendar.App.Views.TextInputDialog"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Name">

    <StackPanel Margin="20" Spacing="14">
        <StackPanel Spacing="6">
            <TextBlock Name="PromptText" TextWrapping="Wrap" Classes="subtle small"/>
            <TextBox Name="ValueBox" KeyDown="OnValueKeyDown"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
            <Button Name="AcceptButton" Content="OK" Classes="accent" Click="OnAcceptClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
