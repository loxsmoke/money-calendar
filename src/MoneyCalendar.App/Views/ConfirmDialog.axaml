<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoneyCalendar.App.Views.ConfirmDialog"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Confirm">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
            <Button Name="ConfirmButton" Content="Delete" Classes="accent" Click="OnConfirmClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
