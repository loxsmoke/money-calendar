<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoneyCalendar.ViewModels"
             x:Class="MoneyCalendar.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- One collapsible group of categories, shared by the custom and built-in panels. -->
        <DataTemplate x:Key="CategoryGroupTemplate" x:DataType="vm:CategoryGroup">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Margin="0,0,0,6">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CountText}" Classes="subtle small" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryRowViewModel">
                            <Grid ColumnDefinitions="18,*,80,150" Margin="4,3,0,3">
                                <Ellipse Grid.Column="0" Width="12" Height="12"
                                         Fill="{Binding Color}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding BadgeText}"
                                           Classes="subtle small" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right">
                                    <Button Content="Rename" FontSize="12" Padding="10,3"
                                            Click="OnEditCategoryClick" CommandParameter="{Binding}"/>
                                    <Button Content="Delete" FontSize="12" Padding="10,3"
                                            Click="OnDeleteCategoryClick" CommandParameter="{Binding}"
                                            IsEnabled="{Binding !IsSystem}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <!-- Preferences -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Preferences" Classes="h2"/>

                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto" RowSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}" MinWidth="140"
                                  HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Custom categories: the ones the user added, and where new ones are made. -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="＋ Add category" Classes="accent"
                                Click="OnAddCategoryClick"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Custom categories" Classes="h2"/>
                            <TextBlock Classes="subtle small"
                                       Text="The income types and expense categories you added. These can be renamed, recolored and deleted."/>
                            <TextBlock Text="{Binding CategoryStatusText}" Classes="income small" TextWrapping="Wrap"
                                       IsVisible="{Binding CategoryStatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding CustomCategoryGroups}"
                                  ItemTemplate="{StaticResource CategoryGroupTemplate}"
                                  IsVisible="{Binding HasCustomCategories}"/>

                    <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding !HasCustomCategories}"
                               Text="You have not added any categories yet. Add one when the built-in list has no name for what you are filing."/>
                </StackPanel>
            </Border>

            <!-- Built-in categories -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Built-in categories" Classes="h2"/>
                        <TextBlock Classes="subtle small"
                                   Text="What income and expenses are filed under out of the box. These can be renamed and recolored, but not deleted."/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CategoryGroups}"
                                  ItemTemplate="{StaticResource CategoryGroupTemplate}"/>
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Export" Classes="h2"/>
                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                               Text="A JSON backup carries accounts, categories and entries and imports back without loss. CSV is a flat list of entries for spreadsheets."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export JSON backup…" Click="OnExportJsonClick" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="Export CSV…" Click="OnExportCsvClick" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Import -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Import" Classes="h2"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="When importing" VerticalAlignment="Center" Classes="subtle"/>
                        <ComboBox ItemsSource="{Binding ImportModes}" SelectedItem="{Binding SelectedImportMode}"
                                  MinWidth="220"/>
                    </StackPanel>
                    <TextBlock Classes="subtle small" TextWrapping="Wrap"
                               Text="Merge keeps what is already here and adds entries the file introduces. Replace deletes every entry first — categories are kept either way."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Import JSON…" Click="OnImportJsonClick" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="Import CSV…" Click="OnImportCsvClick" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                    <TextBlock Classes="subtle small" TextWrapping="Wrap"
                               Text="CSV columns: Date, Kind, Category, Amount, Currency, Account, AccountLast4, Note. Dates are ISO (yyyy-MM-dd); unknown categories are created automatically."/>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Data" Classes="h2"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Accounts" Classes="subtle"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountCountText}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Transactions" Classes="subtle"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransactionCountText}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Repeating transactions" Classes="subtle"
                                   ToolTip.Tip="Counted once each, however many occurrences they draw"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RepeatingCountText}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Custom categories" Classes="subtle"
                                   ToolTip.Tip="The ones you added; built-in categories are not counted"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CustomCategoryCountText}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Database file" Classes="subtle"/>
                        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatabasePathText}"
                                             TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button Content="Delete all transactions" Classes="danger"
                                Click="OnClearTransactionsClick" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="Delete all data" Classes="danger" Click="OnClearDataClick"
                                IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                    <TextBlock Classes="subtle small" TextWrapping="Wrap"
                               Text="Deleting all transactions keeps your accounts. Deleting all data removes the accounts too; categories and settings survive either way."/>
                </StackPanel>
            </Border>

            <!-- Developer: collapsed, because none of this is part of using the app -->
            <Expander Name="DeveloperSection" Header="Developer" IsExpanded="False"
                      HorizontalAlignment="Stretch">
                <StackPanel Spacing="18" Margin="0,8,0,0">

                    <!-- Databases -->
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="＋ New database" Classes="accent"
                                    Click="OnCreateDatabaseClick" IsEnabled="{Binding !IsBusy}"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Databases" FontWeight="SemiBold"/>
                                <TextBlock Classes="subtle small" TextWrapping="Wrap"
                                           Text="Each is a separate ledger — books for something else, or a copy to try things on. Selecting one points the whole app at it and is remembered for next launch."/>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding DatabaseRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DatabaseRowViewModel">
                                    <Border Classes="card" Padding="10,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Button Content="Select" FontSize="12" Padding="10,3"
                                                        Click="OnSelectDatabaseClick" CommandParameter="{Binding}"
                                                        IsVisible="{Binding IsNotCurrent}"/>
                                                <Button Content="Rename" FontSize="12" Padding="10,3"
                                                        Click="OnRenameDatabaseClick" CommandParameter="{Binding}"/>
                                                <Button Content="Clone" FontSize="12" Padding="10,3"
                                                        Click="OnCloneDatabaseClick" CommandParameter="{Binding}"/>
                                                <Button Content="Delete" FontSize="12" Padding="10,3" Classes="danger"
                                                        Click="OnDeleteDatabaseClick" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsNotCurrent}"/>
                                            </StackPanel>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource IncomeBrush}" CornerRadius="3"
                                                            Padding="6,1" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsCurrent}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailText}" Classes="subtle small"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding DatabaseStatusText}" Classes="income small" TextWrapping="Wrap"
                                   IsVisible="{Binding DatabaseStatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <SelectableTextBlock Text="{Binding DatabaseDirectory}" Classes="subtle" FontSize="12"
                                             TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Sample data -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sample data" FontWeight="SemiBold"/>
                        <TextBlock Classes="subtle small" TextWrapping="Wrap"
                                   Text="Fills an empty ledger with a demo one: a few accounts, a salary and the standing bills, and some payments still ahead. It brings its own accounts, so it can only be loaded while there are no transactions and no accounts of your own."/>
                        <Button Content="Load sample data" Command="{Binding LoadSampleDataCommand}"
                                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
                        <TextBlock Classes="subtle small" TextWrapping="Wrap"
                                   IsVisible="{Binding !CanLoadSampleData}"
                                   Text="Unavailable: this ledger already holds data. Settings → Data → Delete all data clears it first."/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Status -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding StatusText}" Classes="income" TextWrapping="Wrap"
                           IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
