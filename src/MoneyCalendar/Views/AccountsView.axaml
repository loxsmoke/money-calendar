<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoneyCalendar.ViewModels"
             x:Class="MoneyCalendar.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <Panel>

        <!-- Loading: skeleton, first load only -->
        <StackPanel IsVisible="{Binding IsLoading}" Spacing="12">
            <Border Classes="card skeleton" Height="48"/>
            <Border Classes="card skeleton" Height="120"/>
            <Border Classes="card skeleton" Height="120"/>
        </StackPanel>

        <!-- Error (first load failed) -->
        <StackPanel IsVisible="{Binding IsError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" HorizontalAlignment="Center"/>
            <Button Content="Retry" Command="{Binding ReloadCommand}" HorizontalAlignment="Center"/>
        </StackPanel>

        <DockPanel IsVisible="{Binding !IsLoading}">

            <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,16,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="＋ Add account" Classes="accent" Click="OnAddClick"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CountText}" Classes="h2"/>
                        <TextBlock Classes="subtle small"
                                   Text="The accounts you keep track of. Each one has a name and a type."/>
                        <TextBlock Text="{Binding StatusText}" Classes="income small"
                                   IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The empty state and the list share the space left under the header: a Panel
                 keeps both filling it, since an undocked DockPanel child would dock left and
                 leave the empty state hugging the edge. -->
            <Panel>
                <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="🏦" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="No accounts yet" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Classes="subtle" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Add a credit card, a checking or savings account, an investment pot, or a mortgage."/>
                </StackPanel>

                <ScrollViewer IsVisible="{Binding IsContent}" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,16,0">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountGroup">
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TypeText}" Classes="h2"/>
                                            <TextBlock Text="{Binding CountText}" Classes="subtle small"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IncomeToDateText}" Classes="income small"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Accounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AccountRowViewModel">
                                                    <Grid ColumnDefinitions="*,110,2*,140,150" Margin="18,4,0,4">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DigitsText}"
                                                                   Classes="subtle" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding NoteText}"
                                                                   Classes="subtle small" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding IncomeToDateText}"
                                                                   Classes.income="{Binding HasIncome}"
                                                                   Classes.subtle="{Binding !HasIncome}"
                                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                                   Margin="0,0,14,0"
                                                                   ToolTip.Tip="Income received into this account to date"/>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Edit" FontSize="12" Padding="10,3"
                                                                    Click="OnEditClick" CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" FontSize="12" Padding="10,3"
                                                                    Click="OnDeleteClick" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Panel>
</UserControl>
