<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MoneyCalendar.Core\MoneyCalendar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sqlite.Core + bundle_green: the plain e_sqlite3 provider. The prototype keeps the
         database unencrypted, so no SQLCipher bundle is pulled in. -->
